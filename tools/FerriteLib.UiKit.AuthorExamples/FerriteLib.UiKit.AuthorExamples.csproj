<Project>
  <PropertyGroup><BaseIntermediateOutputPath>obj/$(UiKitTarget)/</BaseIntermediateOutputPath></PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework Condition="'$(UiKitTarget)' == ''">net472</TargetFramework>
    <TargetFramework Condition="'$(UiKitTarget)' == 'RimWorld17'">net10.0</TargetFramework><LangVersion>latest</LangVersion><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><NuGetAudit>false</NuGetAudit><RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
    <OutputPath>../../dist/build/$(Configuration)/authors/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="obj/**/*.cs" />
    <ProjectReference Include="../../Source/FerriteLib.UiKit/FerriteLib.UiKit.csproj"><Private>false</Private></ProjectReference>
    <PackageReference Condition="'$(UiKitTarget)' == ''" Include="Krafs.Rimworld.Ref" Version="1.6.4871" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(UiKitTarget)' == 'RimWorld17'">
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorld17Dir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(RimWorld17Dir)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
