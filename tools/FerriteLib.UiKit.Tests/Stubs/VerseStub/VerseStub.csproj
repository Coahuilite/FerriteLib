<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Assembly-CSharp</AssemblyName>
    <RootNamespace>Verse</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\bin\stubs\verse\</OutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnityEngineStub\UnityEngineStub.csproj" />
    <!-- The real Assembly-CSharp references UnityEngine.IMGUIModule; the faithful ButtonInvisible
         model needs Event/GUIUtility from the IMGUI stub. -->
    <ProjectReference Include="..\UnityEngineImGuiStub\UnityEngineImGuiStub.csproj" />
    <!-- GUIStyle's font dependency is supplied from the separate text-rendering copy surface.
         Mark it explicitly non-private here too: transitive assembly resolution otherwise copies
         it into Verse's established three-assembly output set. -->
    <ProjectReference Include="..\UnityEngineTextRenderingModuleStub\UnityEngineTextRenderingModuleStub.csproj" Private="false" />
  </ItemGroup>

</Project>
