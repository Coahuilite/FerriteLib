<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <Import Project="../../Source/FerriteLib.UiKit/NeutralSources.props" />
  <Target Name="RecordNeutralInputs" AfterTargets="Build">
    <WriteLinesToFile File="$(OutputPath)production-sources.txt" Lines="@(NeutralProductionSource->'%(FullPath)')" Overwrite="true" />
    <WriteLinesToFile File="$(OutputPath)references.txt" Lines="@(ReferencePath->'%(Filename)')" Overwrite="true" />
  </Target>
</Project>
